# 后端地址：开发期由 Vite 代理转发 /api 与 /health，浏览器侧保持同源，无需后端开 CORS
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 若前后端不同源且后端已开 CORS，可直接填完整地址（如 http://localhost:8000），
# 此时所有请求会绕过代理直连该地址。
VITE_API_BASE_URL=

# 默认是否启用 Mock（true 时不发真实请求，用于无后端的视觉/交互走查）
VITE_USE_MOCK=false

# Reown（WalletConnect）projectId：钱包弹窗的必需项，到 https://cloud.reown.com 免费创建。
# 留空时登录卡会直接提示缺少配置，不会静默失败。
VITE_REOWN_PROJECT_ID=
